# ═══════════════════════════════════════════════════════════
# Variaveis de ambiente para opencode-config
# Copie este arquivo para .env e preencha com suas chaves
# ═══════════════════════════════════════════════════════════

# [OBRIGATORIO] Brave Search API
# Obter em: https://api-dashboard.search.brave.com
# Necessario para: busca web, imagens, videos, noticias
BRAVE_API_KEY=

# [OPCIONAL] GitHub Personal Access Token
# Obter em: https://github.com/settings/tokens
# Necessario para: Issues, PRs, gestao de repos
# Escopo minimo recomendado: public_repo
GITHUB_PERSONAL_ACCESS_TOKEN=
